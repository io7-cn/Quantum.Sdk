<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Quantum.Plugin.Abstraction</AssemblyName>
    <PackageId>Quantum.Plugin.Abstraction</PackageId>
    <Description>The stable .NET plugin ABI for Quantum.</Description>
    <Version>0.3.0</Version>
    <Authors>Quantum contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>quantum;plugin;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/io7-cn/Quantum.Sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IsPackable>true</IsPackable>
    <PathMap Condition="'$(Configuration)' == 'Release' and '$(PathMap)' == ''">$(MSBuildProjectDirectory)=/_/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="NOF.Abstraction" />
    <PackageReference Include="NOF.Contract" />
    <PackageReference Include="NOF.Domain" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../Quantum.Plugin.Analyzers/bin/$(Configuration)/netstandard2.0/Quantum.Plugin.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
    <None Include="../../../docs/en/nuget-readme.md" Pack="true" PackagePath="/README.md" />
  </ItemGroup>
</Project>
